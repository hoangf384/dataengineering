{
  "name": "Spark Dev Container",

  "dockerComposeFile": ["../docker/spark/docker-compose.yaml"],

  "service": "spark-node",


  "workspaceFolder": "/code",

  "updateRemoteUserUID": false,
  "remoteUser": "root",
  "shutdownAction": "none",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/bin/python3"
      }
    }
  }
}