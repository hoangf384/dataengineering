# ======================
# GLOBAL
# ======================
TZ=Asia/Ho_Chi_Minh
PROJECT_NAME=dataengineering
TAILSCALE_IP=100.124.171.81

# ======================
# CASSANDRA
# ======================
CASSANDRA_CLUSTER_NAME=LearningCluster
CASSANDRA_DC=dc1
CASSANDRA_RACK=rack1

CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=100M

# ======================
# MYSQL
# ======================
# MySQL chạy trên EC2, truy cập qua Tailscale
MYSQL_HOST=100.124.171.81
MYSQL_PORT=3306

MYSQL_DATABASE=mydb
MYSQL_USER=spark
MYSQL_PASSWORD=spark

# Root chỉ dùng cho init / admin
MYSQL_ROOT_PASSWORD=root

# ======================
# SPARK
# ======================
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=1G

SPARK_EVENTLOG_ENABLED=true
SPARK_EVENTLOG_DIR=/opt/spark/logs

# ======================
# GRAFANA
# ======================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_TZ=Asia/Ho_Chi_Minh
